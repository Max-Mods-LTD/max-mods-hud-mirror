{
  "name": "maxmods_hud_mirror",
  "version": "0.1.1",
  "description": "Experimental Android screen mirroring to the iDrive 7 windscreen HUD while stationary in Park",
  "main": "javascript/runner.js",
  "author": "Max Mods",
  "license": "GPL-3.0-or-later",
  "mguLocalOnly": true,
  "mguHmi": [
    "ID7"
  ],
  "mguInternet": true,
  "engines": {
    "node": ">=8.7.0"
  },
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "oapAppSettings": {
    "maxDiskUsage": 10485760,
    "cpuLimit": 30,
    "memoryThresholdKB": 102400,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "MMHM",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
