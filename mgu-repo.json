{
  "schema": 1,
  "name": "MaxModsIdriveApps",
  "title": "Max Mods iDrive Apps",
  "components": [
    {
      "id": "maxmods_hud_mirror",
      "kind": "app",
      "path": "car",
      "build": "unit",
      "title": "Max Mods HUD Mirror",
      "description": "Phone mirroring with native BMW menus, one HUD/cluster/iDrive destination, remembered pairing and a connection guide.",
      "version": "0.7.0",
      "mguHmi": [
        "ID7"
      ],
      "requires": {
        "cluster-render": "0.3.7",
        "mgu-render": "0.2.0",
        "mgu-deploy": "0.7.11",
        "maxmods-video": "0.1.0"
      }
    },
    {
      "id": "maxmods-display60",
      "kind": "tool",
      "version": "0.1.0",
      "title": "Max Mods Display60",
      "description": "Optional 60 fps renderer clock for HUD Mirror Smooth mode. Restarts the shared renderer. Uninstall restores earlier settings. Actual display speed needs a car test.",
      "mguHmi": [
        "ID7"
      ],
      "optional": true,
      "uninstallable": true,
      "requires": {
        "cluster-render": "0.3.7",
        "mgu-deploy": "0.7.11"
      },
      "files": [
        {
          "path": "profile.js",
          "from": "profile.js",
          "mode": "0644"
        }
      ],
      "activate": [
        "node",
        "profile.js",
        "enable"
      ],
      "deactivate": [
        "node",
        "profile.js",
        "disable"
      ],
      "path": "tools/Display60"
    },
    {
      "id": "maxmods-video",
      "kind": "tool",
      "version": "0.1.0",
      "title": "Max Mods GPU Video",
      "description": "Uses a separate session of the installed Waze hardware decoder for HUD/cluster video. No firmware patches. JPEG remains the fallback; requires a working installed Waze decoder for GPU mode.",
      "mguHmi": [
        "ID7"
      ],
      "optional": true,
      "uninstallable": true,
      "requires": {
        "mgu-deploy": "0.7.11",
        "cluster-render": "0.3.7"
      },
      "files": [
        {
          "path": "engine.js",
          "from": "engine.js",
          "mode": "0644"
        },
        {
          "path": "run.sh",
          "from": "run.sh",
          "mode": "0755"
        }
      ],
      "units": [
        {
          "name": "maxmods-video.socket",
          "from": "maxmods-video.socket"
        },
        {
          "name": "maxmods-video.service",
          "from": "maxmods-video.service"
        }
      ],
      "enable": [
        {
          "unit": "maxmods-video.socket",
          "target": "sockets.target"
        }
      ],
      "recmgr": [
        "maxmods-video"
      ],
      "activate": [
        "node",
        "engine.js",
        "activate"
      ],
      "path": "tools/Video"
    }
  ]
}
