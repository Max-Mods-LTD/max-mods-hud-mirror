{
  "id": "maxmods-connect",
  "kind": "tool",
  "version": "0.2.0",
  "title": "Max Mods Connect",
  "description": "QR pairing connection helper for matching local car networks; short subnet-restricted leases are removed on close/expiry.",
  "mguHmi": [
    "ID7"
  ],
  "optional": true,
  "uninstallable": true,
  "requires": {
    "mgu-deploy": "0.7.11"
  },
  "files": [
    {
      "path": "bridge.js",
      "from": "bridge.js",
      "mode": "0644"
    },
    {
      "path": "run.sh",
      "from": "run.sh",
      "mode": "0755"
    }
  ],
  "units": [
    {
      "name": "maxmods-connect.socket",
      "from": "maxmods-connect.socket"
    },
    {
      "name": "maxmods-connect.service",
      "from": "maxmods-connect.service"
    }
  ],
  "enable": [
    {
      "unit": "maxmods-connect.socket",
      "target": "sockets.target"
    }
  ],
  "recmgr": [
    "maxmods-connect"
  ],
  "activate": [
    "node",
    "bridge.js",
    "activate"
  ],
  "deactivate": [
    "node",
    "bridge.js",
    "deactivate"
  ]
}
